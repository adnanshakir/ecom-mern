{
  "_postman_variable_scope": "environment",
  "id": "customer-auth-environment",
  "name": "Customer Auth (Local)",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "default",
      "enabled": true,
      "description": "Base URL of backend server"
    },
    {
      "key": "customerOrigin",
      "value": "http://localhost:3000",
      "type": "default",
      "enabled": true,
      "description": "Origin header sent with customer auth requests"
    },
    {
      "key": "customerName",
      "value": "Adz",
      "type": "default",
      "enabled": true,
      "description": "Customer name for Sign Up"
    },
    {
      "key": "customerEmail",
      "value": "adz@example.com",
      "type": "default",
      "enabled": true,
      "description": "Customer email for Sign Up, Sign In, and Email Verification"
    },
    {
      "key": "customerPassword",
      "value": "123456789!",
      "type": "default",
      "enabled": true,
      "description": "Customer password for Sign Up and Sign In"
    },
    {
      "key": "customerPhone",
      "value": "+1234567890",
      "type": "default",
      "enabled": true,
      "description": "Customer phone number for Sign Up, OTP, and Phone Sign In"
    },
    {
      "key": "otpCode",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "OTP code printed in server console logs after running Send Phone OTP. Paste manually before running Verify Phone OTP."
    },
    {
      "key": "frontendCallbackUrl",
      "value": "http://localhost:3000/verify-email",
      "type": "default",
      "enabled": true,
      "description": "Callback URL for email verification flow"
    },
    {
      "key": "lastUserId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Auto-set by Sign Up, Sign In (Email), or Sign In (Phone) test scripts to verify all three auth paths resolve to the same user."
    }
  ],
  "_postman_exported_using": "Postman/10.x.x"
}
