{
  "info": {
    "_postman_id": "ecom-customer-api",
    "name": "ecom-mern — 04 Customer API",
    "description": "Customer phone OTP authentication, customer profile, Cart (including Guest Cart Merge), and Wishlist (including Guest Wishlist Merge).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer — Auth",
      "description": "Customer registration, login, session management, and profile.\n\n**Token separation:** Customer tokens carry `type: \"customer\"` and are **rejected** by admin endpoints (and vice versa).\n\nThe customer refresh token cookie is named `customerRefreshToken`.",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.environment.set('customerAccessToken', json.data.accessToken);",
                  "  pm.environment.set('customerId', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1-555-0100\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new customer and immediately logs them in.\n\n**Rate limit:** 10 requests per 15-minute window.\n\n**Required fields:**\n- `name` — string, min 2 chars\n- `email` — string, valid email\n- `password` — string, min 6 chars\n\n**Optional fields:**\n- `phone` — string\n\n**Error codes:**\n- `409` — Email already in use\n- `422` — Validation error"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"id\": \"60c72b2f9b1e8a001c8e4f90\",\n      \"name\": \"Jane Doe\",\n      \"email\": \"jane@example.com\"\n    }\n  }\n}"
            },
            {
              "name": "409 Email Conflict",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Email already in use\"\n}"
            }
          ]
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.environment.set('customerAccessToken', json.data.accessToken);",
                  "  pm.environment.set('customerId', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "login"
              ]
            },
            "description": "Logs in a customer.\n\n**Rate limit:** 10 requests per 15-minute window.\n\n**Required fields:**\n- `email` — string, valid email\n- `password` — string\n\n**Error codes:**\n- `401` — Invalid credentials\n- `403` — Account deactivated"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"id\": \"60c72b2f9b1e8a001c8e4f90\",\n      \"name\": \"Jane Doe\",\n      \"email\": \"jane@example.com\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Refresh Customer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.environment.set('customerAccessToken', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "refresh"
              ]
            },
            "description": "Exchanges the `customerRefreshToken` HttpOnly cookie for a new access token.\n\n**Rate limit:** 30 requests per 15-minute window."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": { \"id\": \"60c72b2f9b1e8a001c8e4f90\", \"name\": \"Jane Doe\", \"email\": \"jane@example.com\" }\n  }\n}"
            }
          ]
        },
        {
          "name": "Logout Customer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the `customerRefreshToken` cookie."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Logged out successfully\"\n}"
            }
          ]
        },
        {
          "name": "Get My Profile (Customer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated customer's full profile including addresses.\n\n**Auth:** `Authorization: Bearer {{customerAccessToken}}`"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"customer\": {\n      \"_id\": \"60c72b2f9b1e8a001c8e4f90\",\n      \"name\": \"Jane Doe\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"+1-555-0100\",\n      \"isActive\": true,\n      \"addresses\": [],\n      \"lastLogin\": \"2026-08-29T07:00:00.000Z\",\n      \"createdAt\": \"2026-08-29T06:00:00.000Z\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Customer Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"phone\": \"+1-555-0199\",\n  \"addresses\": [\n    {\n      \"label\": \"Home\",\n      \"line1\": \"123 Main Street\",\n      \"line2\": \"Apt 4B\",\n      \"city\": \"New York\",\n      \"state\": \"NY\",\n      \"postalCode\": \"10001\",\n      \"country\": \"US\",\n      \"phone\": \"+1-555-0100\",\n      \"isDefault\": true\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "auth",
                "profile"
              ]
            },
            "description": "Updates the customer's profile (name, phone) and/or replaces their addresses array.\n\n**Auth:** `Authorization: Bearer {{customerAccessToken}}`\n\n**All fields optional:**\n- `name` — string, min 2 chars\n- `phone` — string (nullable)\n- `addresses` — array; each address:\n  - `line1` *(required)* — string\n  - `city` *(required)* — string\n  - `postalCode` *(required)* — string\n  - `country` *(required)* — string\n  - `label`, `line2`, `state`, `phone`, `isDefault` — all optional"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Profile updated successfully\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"60c72b2f9b1e8a001c8e4f90\",\n      \"name\": \"Jane Smith\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"+1-555-0199\",\n      \"addresses\": [\n        {\n          \"_id\": \"60c72b2f9b1e8a001c8e4f91\",\n          \"label\": \"Home\",\n          \"line1\": \"123 Main Street\",\n          \"line2\": \"Apt 4B\",\n          \"city\": \"New York\",\n          \"state\": \"NY\",\n          \"postalCode\": \"10001\",\n          \"country\": \"US\",\n          \"isDefault\": true\n        }\n      ]\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Customer — Cart",
      "description": "Shopping cart management.\n\n**Auth:** `Authorization: Bearer {{customerAccessToken}}`\n\nThe cart is auto-created on first access (find-or-create). Quantity is automatically clamped to available stock.",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart"
              ]
            },
            "description": "Returns the customer's cart. Creates an empty cart if one doesn't exist. Cart items are populated with variant details (sku, price, salePrice, stock, images) and product details (name, slug)."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"_id\": \"60c72b2f9b1e8a001c8e4fa0\",\n    \"customer\": \"60c72b2f9b1e8a001c8e4f90\",\n    \"items\": [\n      {\n        \"variant\": {\n          \"_id\": \"60c72b2f9b1e8a001c8e4f60\",\n          \"sku\": \"MBP14-512GB\",\n          \"price\": 1999.99,\n          \"salePrice\": 1799.99,\n          \"stock\": 25,\n          \"images\": [],\n          \"product\": { \"_id\": \"60c72b2f9b1e8a001c8e4f50\", \"name\": \"MacBook Pro 14\", \"slug\": \"macbook-pro-14\", \"images\": [] }\n        },\n        \"quantity\": 2\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart",
                "items"
              ]
            },
            "description": "Adds a variant to the cart. If already present, **increments** the quantity. Quantity is clamped to available stock.\n\n**Required fields:**\n- `variantId` — MongoDB ObjectId\n- `quantity` — positive integer\n\n**Error codes:**\n- `400` — Variant is inactive\n- `404` — Variant not found"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": { \"_id\": \"60c72b2f9b1e8a001c8e4fa0\", \"items\": [ { \"variant\": { \"_id\": \"...\" }, \"quantity\": 2 } ] },\n  \"message\": null\n}"
            }
          ]
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart/items/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart",
                "items",
                "{{variantId}}"
              ]
            },
            "description": "Sets the quantity of a cart item to the specified value. Quantity is clamped to available stock.\n\n**Passing `quantity: 0` (or negative) removes the item** from the cart.\n\n**Path params:**\n- `variantId` — MongoDB ObjectId of the variant\n\n**Required fields:**\n- `quantity` — integer ≥ 0\n\n**Error codes:**\n- `404` — Cart or item not found"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": { \"items\": [ { \"variant\": {}, \"quantity\": 3 } ] }\n}"
            }
          ]
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart/items/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart",
                "items",
                "{{variantId}}"
              ]
            },
            "description": "Removes a single line item from the cart.\n\n**Path params:**\n- `variantId` — MongoDB ObjectId of the variant to remove\n\n**Error codes:** `404` — Cart not found"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": { \"items\": [] }\n}"
            }
          ]
        },
        {
          "name": "Clear Entire Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart"
              ]
            },
            "description": "Removes all items from the cart.\n\n**Error codes:** `404` — Cart not found"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": { \"_id\": \"60c72b2f9b1e8a001c8e4fa0\", \"items\": [] }\n}"
            }
          ]
        },
        {
          "name": "Merge Guest Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{variantId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/cart/merge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "cart",
                "merge"
              ]
            },
            "description": "Merges guest cart items (from local storage) into the customer's authenticated cart upon login.\n\n- Clamps quantities to available variant stock.\n- Safely skips inactive/deleted variant IDs.\n- Returns the full populated customer cart."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"_id\": \"60c72b2f9b1e8a001c8e4f60\",\n    \"customer\": \"60c72b2f9b1e8a001c8e4f01\",\n    \"items\": [\n      {\n        \"variant\": {\n          \"_id\": \"60c72b2f9b1e8a001c8e4f55\",\n          \"sku\": \"TEE-BLK-M\",\n          \"price\": 499,\n          \"stock\": 20,\n          \"product\": {\n            \"_id\": \"60c72b2f9b1e8a001c8e4f50\",\n            \"name\": \"Oversized Tee\",\n            \"slug\": \"oversized-tee\"\n          }\n        },\n        \"quantity\": 2\n      }\n    ]\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Customer — Wishlist",
      "description": "Wishlist management.\n\n**Auth:** `Authorization: Bearer {{customerAccessToken}}`\n\nThe wishlist is auto-created on first access.",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/wishlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "wishlist"
              ]
            },
            "description": "Returns the customer's wishlist with populated products (name, slug, images, brand, category, status) and lightweight variant pricing data."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"_id\": \"60c72b2f9b1e8a001c8e4fb0\",\n    \"customer\": \"60c72b2f9b1e8a001c8e4f90\",\n    \"products\": [\n      {\n        \"_id\": \"60c72b2f9b1e8a001c8e4f50\",\n        \"name\": \"MacBook Pro 14\",\n        \"slug\": \"macbook-pro-14\",\n        \"images\": [],\n        \"brand\": \"60c72b2f9b1e8a001c8e4f30\",\n        \"category\": \"60c72b2f9b1e8a001c8e4f41\",\n        \"status\": \"active\",\n        \"variants\": [\n          { \"_id\": \"60c72b2f9b1e8a001c8e4f60\", \"price\": 1999.99, \"salePrice\": 1799.99, \"stock\": 25 }\n        ]\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Add Product to Wishlist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
