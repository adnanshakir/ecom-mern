            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "auth", "sign-in", "email"]
            },
            "description": "Hits the old email+password sign-in endpoint directly.\n\nExpected: **400** with a message indicating email/password auth is not enabled."
