        {
          "name": "REG-5: Duplicate phone number — second sign-up must fail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Send an OTP to the phone number already registered from the Sign-Up folder.",
                  "// The send step itself will succeed (200) — the uniqueness gate fires at verify.",
                  "// To test the duplicate-rejection specifically:",
                  "//   1. Use a DIFFERENT phone number here (not the one already signed up).",
                  "//   2. Complete verify once to create the account.",
                  "//   3. Manually edit the verify body to use the same phone a second time.",
                  "//   4. The second verify should return a user object (sign-in) — NOT a new account.",
                  "// This request just confirms send-otp always succeeds.",
                  "pm.test('Send OTP returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{customerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/phone-number/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "auth", "phone-number", "send-otp"]
            },
            "description": "Regression: confirms the phone-number uniqueness constraint still holds. Sending an OTP to a number that is already registered should succeed (200) — the existing user simply receives a new code and signing in returns that same user, not a duplicate.\n\nTo confirm no duplicate is created: after verifying, check MongoDB Compass that `customerUser` has exactly one document with this phone number."
          }
        }
      ]
