# ---- SERVER ----
# Port the Express server listens on
PORT=5000
# Public URL of the Next.js storefront (used for CORS and links)
FRONTEND_URL=http://localhost:3000

# ---- DATABASE ----
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ---- AUTH ----
# Secret used to sign admin JWT access/refresh tokens
JWT_SECRET=change-me-long-random-string
# Secret used by Better Auth (customer login) to sign sessions
BETTER_AUTH_SECRET=change-me-long-random-string
# Public base URL of the backend as seen by Better Auth
BETTER_AUTH_URL=http://localhost:5000
# Comma-separated origins allowed to use Better Auth (storefront URLs)
TRUSTED_ORIGINS=http://localhost:3000

# Dev shortcut: accept a fixed OTP instead of sending real SMS.
# MUST be false (or removed) in production.
ALLOW_MASTER_OTP=false
MASTER_OTP_CODE=000000

# --- IMAGES (ImageKit) ----
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# --- PAYMENTS (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- INVENTORY ----
# Products below this stock count show up as "low stock"
LOW_STOCK_THRESHOLD=20

# ---- PUSH NOTIFICATIONS (Firebase Cloud Messaging) ----
# Firebase service account key, base64 encoded (single line, no quotes).
# Generate: Firebase Console > Project settings > Service accounts > new key,
# then base64 the file with PowerShell. Never commit or share this value.
FIREBASE_SERVICE_ACCOUNT_B64=

# Local testing only: true = log pushes in the terminal instead of sending.
# Ignored when NODE_ENV=production. Leave false/empty on Render.
ENABLE_PUSH_STUB=false

# Local testing only: true = turn off cron jobs (scheduled sends, cart reminders).
# Leave false/empty on Render.
DISABLE_SCHEDULER=false

# Testing safety: comma-separated customer IDs. If set, personal pushes
# (cart reminders, price drops, segment campaigns) go ONLY to these customers.
# Broadcasts to everyone are not affected. Leave empty in production.
PUSH_ALLOWLIST_CUSTOMER_IDS=