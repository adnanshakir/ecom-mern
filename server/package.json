{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:files": "eslint --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:notifications": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand src/tests/notifications"
  },
  "jest": {
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/services/notificationService.js",
      "src/services/notificationTriggers.js",
      "src/services/notificationAudience.js",
      "src/controllers/adminNotificationController.js"
    ],
    "coverageThreshold": {
      "src/services/notificationService.js": {
        "lines": 90,
        "branches": 85
      },
      "src/services/notificationTriggers.js": {
        "lines": 90,
        "branches": 85
      },
      "src/services/notificationAudience.js": {
        "lines": 90,
        "branches": 85
      },
      "src/controllers/adminNotificationController.js": {
        "lines": 90,
        "branches": 85
      }
    }
  },
  "keywords": [],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-csv": "^5.0.7",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "slugify": "^1.6.9",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
