{
  "info": {
    "_postman_id": "customer-routes-collection",
    "name": "customer-routes",
    "description": "# customer-routes Postman Collection\n\nComprehensive Postman collection containing customer routes across:\n- `customerAuth.js` (Better Auth phone OTP authentication & session management)\n- `profile.routes.js` (Customer profile updates: name, email, address, addresses)\n- `cart.routes.js` (Customer cart operations)\n- `wishlist.routes.js` (Customer wishlist operations)\n- `review.routes.js` (Authenticated customer product reviews)\n- `customerImage.routes.js` (Customer image uploads)\n- `public.routes.js` (Public storefront browsing & public reviews)\n\n## Authentication & Headers\nRequests automatically include `Origin: {{customerOrigin}}` (default `http://localhost:3000`) in pre-request scripts to satisfy backend CORS policy. Authentication uses HttpOnly cookies managed automatically by Postman's Cookie Jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer Auth (customerAuth.js)",
      "description": "Endpoints powered by Better Auth for customer phone OTP authentication, session management, and sign-out.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const origin = pm.environment.get('customerOrigin') || 'http://localhost:3000';",
              "pm.request.headers.upsert({ key: 'Origin', value: origin });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "1. Send Phone OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response confirms code sent', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{customerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/phone-number/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "auth",
                "phone-number",
                "send-otp"
              ]
            },
            "description": "Sends an OTP to the given phone number.\n\nLook for `[DEV OTP LOG - PHONE SMS]` in the server console log."
          }
        },
        {
          "name": "2. Verify Phone OTP (sign-up / sign-in)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains user with phoneNumber', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user).to.have.property('phoneNumber');",
                  "    const userId = jsonData.user.id || jsonData.user._id;",
                  "    pm.expect(userId).to.be.a('string').that.is.not.empty;",
                  "    pm.environment.set('lastUserId', userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{customerPhone}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/phone-number/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "auth",
                "phone-number",
                "verify"
              ]
            },
            "description": "Verifies phone OTP and creates customer account (if new) or signs in (if existing)."
          }
        },
        {
          "name": "3. Get Customer Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains valid session and user profile', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData).to.have.property('session');",
                  "    pm.expect(jsonData.user).to.have.property('id');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/get-session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "auth",
                "get-session"
              ]
            },
            "description": "Fetches currently authenticated customer's session and user details. Requires active session cookie."
          }
        },
        {
          "name": "4. Sign Out",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/auth/sign-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "auth",
                "sign-out"
              ]
            },
            "description": "Invalidates customer's active session cookie."
          }
        }
      ]
    },
